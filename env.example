# Copy this file to .env and fill in real values.
# .env is gitignored. This file holds variable NAMES ONLY, never values.

# --- AWS (local dev only; CI uses OIDC, no keys) ---
AWS_REGION=eu-west-2
AWS_PROFILE=

# --- Models ---
BEDROCK_LLM_MODEL_ID=
EMBEDDING_MODEL=

# --- Langfuse (self-hosted) ---
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- App ---
VECTOR_STORE_PATH=./chroma
LOG_LEVEL=INFO
